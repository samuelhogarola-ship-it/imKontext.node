# Server port (default: 3000)
PORT=3000

# Supabase connection.
# The server has built-in fallbacks pointing at the project's public instance,
# so these variables are only needed to target a different Supabase project (e.g. staging).
# Integration tests (npm run test:integration) work without them.
SUPABASE_URL=https://fvhxbbhxucwawypfzikf.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
