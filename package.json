{
  "name": "imkontext-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node app wrapper for the current imKontext frontend and future API migration.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "prepare": "node .husky/install.mjs",
    "lint:staged": "lint-staged --no-stash --no-hide-partially-staged",
    "start": "node server.js",
    "test:unit": "node --test e2e/umami-analytics.test.mjs",
    "test:e2e": "node --test e2e/umami-analytics.test.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "playwright test --config playwright.integration.config.js"
  },
  "lint-staged": {
    "**/*": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
